---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import PostCard from "../../../components/PostCard.astro";
import { copy, locales, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = copy[lang];
const imageAlts =
  lang === "es"
    ? {
        checkpoint: "Control de videojuegos sobre un escritorio de madera con luz cálida",
        newen: "Persona escribiendo en un cuaderno durante una pausa tranquila",
        daypeek: "Agenda mensual abierta junto a una taza de café",
      }
    : {
        checkpoint: "Game controller on a wooden desk in warm light",
        newen: "Person writing in a notebook during a quiet pause",
        daypeek: "Open monthly planner beside a cup of coffee",
      };
---

<BaseLayout title={`${t.blogIndex.title} · Capybarista`} description={t.blogIndex.intro} lang={lang}>
  <div class="page">
    <Header lang={lang} labels={t.nav} />
    <main class="shell blog-shell">
      <section class="page-title blog-page-title">
        <h1>{t.blogIndex.title}</h1>
        <p>{t.blogIndex.intro}</p>
      </section>

      <section class="blog-grid page-list" aria-label={t.blogIndex.title}>
        <PostCard
          app="Checkpoint"
          title={t.posts.checkpoint.title}
          href={`/${lang}/blog/checkpoint/primer-checkpoint/`}
          excerpt={t.posts.checkpoint.excerpt}
          cta={t.home.readGuide}
          imageSrc="/blog-checkpoint-unsplash.jpg"
          imageAlt={imageAlts.checkpoint}
          featured
        />
        <PostCard
          app="Newen"
          title={t.posts.newen.title}
          href={`/${lang}/blog/newen/rutina-ligera/`}
          excerpt={t.posts.newen.excerpt}
          cta={t.home.readGuide}
          imageSrc="/blog-newen-unsplash.jpg"
          imageAlt={imageAlts.newen}
        />
        <PostCard
          app="DayPeek"
          title={t.posts.daypeek.title}
          href={`/${lang}/blog/daypeek/ordenar-tu-dia/`}
          excerpt={t.posts.daypeek.excerpt}
          cta={t.home.readGuide}
          imageSrc="/blog-daypeek-unsplash.jpg"
          imageAlt={imageAlts.daypeek}
        />
      </section>
    </main>
    <Footer lang={lang} labels={t.nav} />
  </div>
</BaseLayout>
